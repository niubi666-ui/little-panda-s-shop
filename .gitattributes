# Stable text storage; Windows launchers retain CRLF when checked out.
* text=auto eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.json text eol=lf
*.po text eol=lf
*.md text eol=lf
*.py text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Keep binary art in this local repository, without an LFS server dependency.
*.blend binary
*.glb binary
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.exr binary
*.hdr binary
*.res binary
*.ttf binary
*.otf binary
