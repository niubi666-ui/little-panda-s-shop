{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "_comment",
    "max_zones",
    "elements",
    "reactions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "_comment": {
      "type": "string",
      "minLength": 0
    },
    "max_zones": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "max_stacks",
          "duration_sec",
          "tick_sec",
          "damage_per_tick_per_stack",
          "slow_status_id",
          "freeze_status_id",
          "discharge_damage",
          "discharge_radius_m",
          "discharge_max_targets",
          "damage_taken_per_stack",
          "poise_damage_ratio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "max_stacks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "duration_sec": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 60
          },
          "tick_sec": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "damage_per_tick_per_stack": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "slow_status_id": {
            "type": "string",
            "pattern": "^[a-z_]*$",
            "minLength": 0
          },
          "freeze_status_id": {
            "type": "string",
            "pattern": "^[a-z_]*$",
            "minLength": 0
          },
          "discharge_damage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "discharge_radius_m": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "discharge_max_targets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "damage_taken_per_stack": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "poise_damage_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "reactions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "elements",
          "damage",
          "damage_per_stack",
          "radius_m",
          "area_damage",
          "max_targets",
          "knockback_mps",
          "knockback_sec",
          "vulnerability",
          "vulnerability_sec",
          "slow_status_id",
          "zone_radius_m",
          "zone_sec",
          "zone_tick_sec",
          "zone_damage_per_tick"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "elements": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          },
          "damage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "damage_per_stack": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "radius_m": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "area_damage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "max_targets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "knockback_mps": {
            "type": "number",
            "minimum": -40,
            "maximum": 40
          },
          "knockback_sec": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "vulnerability": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "vulnerability_sec": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "slow_status_id": {
            "type": "string",
            "pattern": "^[a-z_]*$",
            "minLength": 0
          },
          "zone_radius_m": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "zone_sec": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "zone_tick_sec": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "zone_damage_per_tick": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    }
  }
}
