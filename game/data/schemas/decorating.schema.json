{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grid_size_m",
    "maximum_instances",
    "furniture"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "grid_size_m": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1
    },
    "maximum_instances": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "furniture": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "asset_id",
          "footprint_cells"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "footprint_cells": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      }
    }
  }
}
