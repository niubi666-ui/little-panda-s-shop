{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "generation_version",
    "training_depth",
    "training_max_depth",
    "wave_count",
    "minimum_budget_fraction",
    "role_caps",
    "escort_rules",
    "depth_bands",
    "combinations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "generation_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "training_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "training_max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "wave_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "minimum_budget_fraction": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "role_caps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranged",
        "charger",
        "support"
      ],
      "properties": {
        "ranged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "charger": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "support": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "escort_rules": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "requires_actor_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "requires_actor_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "depth_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min_depth",
          "budget",
          "max_enemies"
        ],
        "properties": {
          "min_depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "budget": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "max_enemies": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        }
      }
    },
    "combinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "weight",
          "enemy_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1000
          },
          "enemy_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
