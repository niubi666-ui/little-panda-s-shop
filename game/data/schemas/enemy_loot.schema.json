{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "tables"
  ],
  "properties": {
    "content_version": {"type": "string", "minLength": 1},
    "schema_version": {
      "const": 1
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "chance",
                "count_min",
                "count_max"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "count_min": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "count_max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              }
            }
          }
        }
      }
    }
  }
}
