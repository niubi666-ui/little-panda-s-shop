{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "_comment",
    "start_preset",
    "room_count",
    "start_depth",
    "depth_per_room",
    "boss_actor_id",
    "boss_depth",
    "exit_count_min",
    "exit_count_max",
    "first_exit_count",
    "rewards",
    "boon_elements",
    "boon_profile",
    "upgrade_profile",
    "heal_amount",
    "gold_amount",
    "clear_gold",
    "victory_gold"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "_comment": {
      "type": "string",
      "minLength": 0
    },
    "start_preset": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "room_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "start_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "depth_per_room": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "boss_actor_id": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "boss_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "exit_count_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "exit_count_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "first_exit_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "rewards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "weight"
        ],
        "properties": {
          "kind": {
            "enum": [
              "boon",
              "upgrade",
              "heal",
              "gold"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    },
    "boon_elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "boon_profile": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "upgrade_profile": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "heal_amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "gold_amount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "clear_gold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "victory_gold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    }
  }
}
