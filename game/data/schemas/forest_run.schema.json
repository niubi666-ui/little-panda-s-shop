{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "_comment",
    "start_preset",
    "areas",
    "map",
    "awakening_after_area",
    "awakening",
    "card_weighting",
    "battle_profile",
    "elite_profile",
    "boss_profile",
    "upgrade_profile",
    "clear_gold",
    "treasure",
    "rest_heal",
    "event",
    "shop"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "_comment": {
      "type": "string",
      "minLength": 0
    },
    "start_preset": {
      "type": "string",
      "pattern": "^[a-z_0-9]+$"
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "start_depth",
          "depth_per_layer",
          "elite_depth_bonus",
          "boss_actor_id",
          "boss_depth"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_0-9]+$"
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "start_depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "depth_per_layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "elite_depth_bonus": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "boss_actor_id": {
            "type": "string",
            "pattern": "^[a-z_0-9]+$"
          },
          "boss_depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        }
      }
    },
    "map": {},
    "awakening_after_area": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "awakening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "guarantee_same",
        "guarantee_new"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "guarantee_same": {
          "type": "boolean"
        },
        "guarantee_new": {
          "type": "boolean"
        }
      }
    },
    "card_weighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_element_scale",
        "elemental_action_scale",
        "max_per_action"
      ],
      "properties": {
        "owned_element_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "elemental_action_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "max_per_action": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "battle_profile": {
      "type": "string",
      "pattern": "^[a-z_0-9]+$"
    },
    "elite_profile": {
      "type": "string",
      "pattern": "^[a-z_0-9]+$"
    },
    "boss_profile": {
      "type": "string",
      "pattern": "^[a-z_0-9]+$"
    },
    "upgrade_profile": {
      "type": "string",
      "pattern": "^[a-z_0-9]+$"
    },
    "clear_gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battle",
        "elite",
        "boss"
      ],
      "properties": {
        "battle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "elite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "boss": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "treasure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "awakening_chance",
        "gold"
      ],
      "properties": {
        "awakening_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "rest_heal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomes",
        "gold",
        "heal",
        "blood_cost",
        "card_profile",
        "blood_card_profile"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "weight"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "awakening",
                  "card",
                  "gold",
                  "heal",
                  "blood_card"
                ]
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "heal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "blood_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "card_profile": {
          "type": "string",
          "pattern": "^[a-z_0-9]+$"
        },
        "blood_card_profile": {
          "type": "string",
          "pattern": "^[a-z_0-9]+$"
        }
      }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_price",
        "upgrade_price",
        "heal_price",
        "heal_amount",
        "card_profile"
      ],
      "properties": {
        "card_price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "upgrade_price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "heal_price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "heal_amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "card_profile": {
          "type": "string",
          "pattern": "^[a-z_0-9]+$"
        }
      }
    }
  }
}
