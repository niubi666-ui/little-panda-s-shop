{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_version",
    "content_version",
    "cell_size_m",
    "actor_clearance_m",
    "spawn_clearance_m",
    "placement_gap_m",
    "placement_attempts",
    "interaction_range_m",
    "navigation_arrival_m",
    "groups",
    "props",
    "loot_items",
    "composition_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 3,
      "maximum": 3,
      "const": 3
    },
    "generation_version": {
      "type": "integer",
      "minimum": 3,
      "maximum": 3,
      "const": 3
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "cell_size_m": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 2
    },
    "actor_clearance_m": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 2
    },
    "spawn_clearance_m": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 5
    },
    "placement_gap_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "placement_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "interaction_range_m": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 5
    },
    "navigation_arrival_m": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choices",
          "count_min",
          "count_max"
        ],
        "properties": {
          "choices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "count_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40
          },
          "count_max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40
          }
        }
      }
    },
    "props": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "health",
          "name_key",
          "loot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "obstacle",
              "destructible",
              "searchable"
            ]
          },
          "health": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "loot": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "count_min",
                "count_max"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "count_min": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                },
                "count_max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                }
              }
            }
          }
        }
      }
    },
    "loot_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "composition_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
