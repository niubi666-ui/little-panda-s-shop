{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "content_version",
    "start_node_ids",
    "nodes",
    "edges",
    "starter_build_preset",
    "rewards"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "content_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "start_node_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layer",
          "column",
          "kind",
          "depth",
          "template_id",
          "reward_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "kind": {
            "enum": [
              "battle",
              "elite",
              "terminal"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "template_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "reward_id": {
            "const": "none"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        }
      }
    },
    "starter_build_preset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "rewards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "const": "none"
          },
          "kind": {
            "const": "none"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
