msgstr "Melee and projectile contacts slow movement by {slow_percent}% for {duration_sec} s; reapply keeps the longer remaining duration."

msgid "build.test.contact_slow.name"
msgstr "Test · Contact slow"

msgid "build.test.freeze_duration.description"
msgstr "This action’s future freeze effects gain {bonus_percent}% duration, bounded by the status duration cap. Another action’s freeze cannot satisfy its requirement."

msgid "build.test.freeze_duration.name"
msgstr "Test · Longer freeze"

msgid "build.test.mechanism_hint"
msgstr "LMB Combo · RMB Heavy · Q Wave · T Test Arrow · Blue Ring = Frost"

msgid "build.test.power.description"
msgstr "Both actions gain {bonus_percent}% attack damage. Action bonuses add before the final cap; derived damage does not multiply the bonus again."

msgid "build.test.power.name"
msgstr "Test · Sharpened blade"

msgid "build.test.split.description"
