msgid "build.test.agility.description"
msgstr "Normal movement speed increases by {bonus_percent}%. Dodge speed stays unchanged."

msgid "build.test.agility.name"
msgstr "Test · Fleet foot"

msgid "build.test.arrow_hint"
msgstr "Projectile test: T fires an arrow. Choose Split and hit an enemy; Sword wave is not required."

msgid "build.test.blast.description"
msgstr "Melee and projectiles explode on enemy contact: {radius_m} m radius, {damage_percent}% attack damage with radial falloff. Excludes the direct target and targets behind walls."

msgid "build.test.blast.name"
msgstr "Test · Impact blast"

msgid "build.test.chain.description"
msgstr "A melee or wave hit chains to up to {jumps} other enemies within {radius_m} m. It starts at {damage_percent}% of damage dealt, retaining {falloff_percent}% each hop. Once per cast."

msgid "build.test.chain.name"
msgstr "Test · Echo chain"

msgid "build.test.contact_freeze.description"
msgstr "Direct contact freezes enemies for {duration_sec}s. Freeze cannot refresh; thaw grants brief freeze immunity."

msgid "build.test.contact_freeze.name"
msgstr "Test · Contact freeze"

msgid "build.test.contact_slow.description"
msgstr "Melee and projectile contacts slow movement by {slow_percent}% for {duration_sec} s; reapply keeps the longer remaining duration."

msgid "build.test.contact_slow.name"
msgstr "Test · Contact slow"

msgid "build.test.freeze_duration.description"
msgstr "Future attacks carrying freeze gain {bonus_percent}% duration, bounded by the status duration cap."

msgid "build.test.freeze_duration.name"
msgstr "Test · Longer freeze"

msgid "build.test.mechanism_hint"
msgstr "Left menu: presets | T: arrow | Orange: blast | Cyan: frost | Blue shell: frozen"

msgid "build.test.power.description"
msgstr "Attack damage increases by {bonus_percent}%. Sword waves inherit this bonus; derived damage does not multiply it again."

msgid "build.test.power.name"
msgstr "Test · Sharpened blade"

msgid "build.test.split.description"
msgstr "Compatible projectiles split on enemy contact into {count} children, dealing {damage_percent}% of parent damage. Up to {max_generation} generation; excludes ancestor targets."

msgid "build.test.split.name"
msgstr "Test · Projectile split"

msgid "build.test.wave.description"
msgstr "Each attack releases a wave, even on a miss. It deals {damage_percent}% of that attack's damage and stops on a wall or enemy."

msgid "build.test.wave.name"
msgstr "Test · Sword wave"

msgid "build.test_offer"
msgstr "Test: offer upgrades"

