msgid "build.test.split.name"
msgstr "Test · Projectile split"

msgid "build.test.wave.description"
msgstr "Each attack releases a wave, even on a miss. It deals {damage_percent}% of that attack's damage and stops on a wall or enemy."

msgid "build.test.wave.name"
msgstr "Test · Sword wave"

