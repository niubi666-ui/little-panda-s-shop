msgid "build.element.ice.name"
msgstr "寒冰附魔"

msgid "build.element.thunder.description"
msgstr "命中时施加感电：下一次命中它时放出电弧，伤害它和附近最多 3 个敌人。"

msgid "build.element.thunder.name"
msgstr "雷霆附魔"

msgid "build.element_boost.dual_lava.description"
msgstr "熔岩伤害提高 {damage_bonus_percent}%，范围扩大 {radius_bonus_m} 米。"

msgid "build.element_boost.dual_lava.name"
msgstr "地火"

msgid "build.element_boost.dual_magnet.description"
msgstr "磁暴伤害提高 {damage_bonus_percent}%，吸附范围扩大 {radius_bonus_m} 米。"

msgid "build.element_boost.dual_magnet.name"
msgstr "磁岩"

msgid "build.element_boost.dual_overload.description"
msgstr "过载伤害提高 {damage_bonus_percent}%，范围扩大 {radius_bonus_m} 米。"

msgid "build.element_boost.dual_overload.name"
msgstr "雷火"

msgid "build.element_boost.dual_shatter.description"
msgstr "先冻结，再用土攻击触发碎冰（Boss 的冰冻减速窗口也算）。碎冰伤害提高 {damage_bonus_percent}%，范围扩大 {radius_bonus_m} 米。"

msgid "build.element_boost.dual_shatter.name"
msgstr "冰岩"

msgid "build.element_boost.dual_steam.description"
msgstr "蒸腾伤害提高 {damage_bonus_percent}%。"

msgid "build.element_boost.dual_steam.name"
msgstr "沸腾"

msgid "build.element_boost.dual_superconduct.description"
msgstr "超导伤害提高 {damage_bonus_percent}%，范围扩大 {radius_bonus_m} 米。"

msgid "build.element_boost.dual_superconduct.name"
msgstr "冰雷"

msgid "build.element_boost.earth_crush.description"
msgstr "每层碎甲额外使敌人受到的伤害提高 {add_percent}%。"

msgid "build.element_boost.earth_crush.name"
msgstr "崩岩"

msgid "build.element_boost.earth_layers.description"
msgstr "碎甲最多可叠层数 +{add}。"

msgid "build.element_boost.earth_layers.name"
msgstr "层岩"

msgid "build.element_boost.earth_quake.description"
msgstr "土元素命中额外造成 {add_percent}% 破防值，更快打破霸体。"

msgid "build.element_boost.earth_quake.name"
msgstr "震地"

msgid "build.element_boost.fire_blaze.description"
msgstr "灼烧最多可叠层数 +{add}。"

msgid "build.element_boost.fire_blaze.name"
msgstr "烈焰"

msgid "build.element_boost.fire_kindling.description"
msgstr "灼烧每层每跳伤害 +{add}。"

msgid "build.element_boost.fire_kindling.name"
msgstr "余烬"

msgid "build.element_boost.fire_linger.description"
msgstr "灼烧持续时间 +{add} 秒。"

msgid "build.element_boost.fire_linger.name"
msgstr "久燃"

msgid "build.element_boost.ice_brittle.description"
msgstr "每层冰寒使敌人受到的伤害提高 {add_percent}%。"

msgid "build.element_boost.ice_brittle.name"
msgstr "脆冰"

msgid "build.element_boost.ice_deep.description"
msgstr "冻结所需的冰寒层数 {add}，更快冻结。"

msgid "build.element_boost.ice_deep.name"
msgstr "深寒"

msgid "build.element_boost.ice_lasting.description"
msgstr "冰寒持续时间 +{add} 秒。"

msgid "build.element_boost.ice_lasting.name"
msgstr "霜重"

msgid "build.element_boost.thunder_chain.description"
msgstr "感电放电时多电 {add} 个敌人。"

msgid "build.element_boost.thunder_chain.name"
msgstr "连环雷"

msgid "build.element_boost.thunder_reach.description"
msgstr "放电距离 +{add} 米。"

msgid "build.element_boost.thunder_reach.name"
msgstr "远雷"

msgid "build.element_boost.thunder_surge.description"
msgstr "感电放电伤害 +{add}。"

msgid "build.element_boost.thunder_surge.name"
msgstr "雷涌"

msgid "build.empty"
msgstr "尚无升级，左键、R 与右键 基础动作均可使用"

msgid "build.error"
msgstr "选择未成功，当前构筑未改变，请重试。"

