msgid "build.mastery.earth_burst.description"
msgstr "需要两个按键带土。碎甲叠满时地面崩裂：{damage} 伤害（每层再 +{damage_per_stack}），波及 {radius_m} 米内 {max_targets} 个敌人并挂 {spread_stacks} 层碎甲。"

msgid "build.mastery.earth_burst.name"
msgstr "地裂（土专精）"

msgid "build.mastery.earth_weight.description"
msgstr "需要两个按键带土。碎甲每层易伤再 +{add_percent}%。"

msgid "build.mastery.earth_weight.name"
msgstr "山岳共鸣（土专精）"

msgid "build.mastery.fire_burst.description"
msgstr "需要两个按键带火。灼烧叠满时引爆：{damage} 伤害（每层再 +{damage_per_stack}），波及 {radius_m} 米内 {max_targets} 个敌人并给它们挂 {spread_stacks} 层灼烧。"

msgid "build.mastery.fire_burst.name"
msgstr "焚爆（火专精）"

msgid "build.mastery.fire_heat.description"
msgstr "需要两个按键带火。灼烧每层每跳伤害 +{add}。"

msgid "build.mastery.fire_heat.name"
