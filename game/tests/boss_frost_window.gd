extends "res://tests/ranger_sequences.gd"
const BuildLoader = preload("res://content/builds/build_loader.gd")
const Statuses = preload("res://combat/status/status_runtime.gd")
var window_facts := 0
func run() -> void:
	combat = preload("res://content/combat/combat_loader.gd").new().load_catalog()
	catalog = preload("res://content/enemies/enemy_loader.gd").new().load_catalog(combat)
	var loader := BuildLoader.new()
	var builds = loader.load_catalog()
	if builds == null: print(loader.errors)
	check(builds != null and catalog != null, "content loads")
	if builds == null or catalog == null: quit(1); return
	player = make_actor("player",1); ranger = make_actor("elite_ranger",2)
	runtime = Runtime.new()
	runtime.configure(player,.35,func(a):return a.position+Vector3.UP,func(_a,_b,_r):return 1.0)
	brain = runtime.add(ranger,catalog.profile("elite_ranger"),Callable(),func(_a,_b):return true,func(_a,_b):return true,{"roll_path":func(_a,_b):return true,"ground":func(_p):return true,"rain_escape":func(_a,_c):return true,"seed":19})
	brain.shot_requested.connect(func(_a,d,c): shots.append({"direction":d,"settings":c}))
	var statuses := Statuses.new(); statuses.configure(builds)
	statuses.freeze_window_applied.connect(func(_t,_id,_s): window_facts += 1)
	var freeze: Dictionary = builds.status("test_freeze")
	var response: Dictionary = builds.status_response("elite_ranger")
	var raw: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/builds/prototype.json"))
	for field in ["freeze_mode", "freeze_move_scale", "freeze_action_scale", "thaw_immunity_scale"]:
		var invalid := raw.duplicate(true)
		invalid.status_rules.responses[0][field] = "unknown" if field == "freeze_mode" else 0.0
		check(BuildLoader.new().decode(invalid) == null, "invalid response field rejected: " + field)
	reset(); brain._start("charged")
	brain.tick(.1)
	var left: float = brain.time_left
	var cast_id: int = brain.cast_id
	check(statuses.apply(ranger, freeze.id, freeze.duration_sec, {}), "first contact opens boss frost window")
	check(not ranger.control_locked and ranger.control_action_scale == response.freeze_action_scale, "boss remains active with configured local tempo")
	brain.tick(.2)
	check(is_equal_approx(brain.time_left, left-.2*response.freeze_action_scale) and brain.cast_id == cast_id, "windup slows without restart")
	check(not statuses.apply(ranger,freeze.id,freeze.duration_sec, {}) and window_facts == 1, "window cannot refresh or repeat success fact")
	check(player.control_action_scale == 1.0, "player clock is independent")
	statuses.tick(0)
	check(statuses.snapshot(ranger)[freeze.id].remaining == freeze.duration_sec, "paused status clock holds")
	statuses.tick(freeze.duration_sec)
	check(ranger.control_action_scale == 1.0 and brain.cast_id == cast_id, "normal clock expiry restores ongoing action")
	brain.tick(brain.time_left + .001)
	check(shots.size() == 1, "resumed charged shot fires once")
	player.position = Vector3(30,0,30)
	var start: Vector3 = runtime.projectiles[0].position
	var speed: float = runtime.projectiles[0].config.projectile_speed_mps
	runtime.after_motion(.01)
	check(is_equal_approx(start.distance_to(runtime.projectiles[0].position),speed*.01), "released arrow uses independent time")
	check(not statuses.apply(ranger,freeze.id,freeze.duration_sec, {}), "configured thaw immunity rejects window")
	statuses.clear(); reset(); brain._start("rain")
	brain.tick(brain.windup_duration)
	statuses.apply(ranger,freeze.id,freeze.duration_sec,{})
	var rain_before: Dictionary = runtime.rains[0].duplicate(true)
	runtime.after_motion(.01)
	check(runtime.rains[0] != rain_before, "existing rain advances while caster is slowed")
	statuses.clear(); reset()
	brain.state = "rolling"; brain.roll_duration = 1.0; brain.roll_left = 1.0
	brain.roll_distance = 4.0; brain.roll_direction = Vector3.RIGHT
	statuses.apply(ranger,freeze.id,freeze.duration_sec,{})
	brain.tick(.1)
	check(is_equal_approx(brain.roll_left,1.0-.1*response.freeze_action_scale), "roll progress uses local action clock")
	check(is_equal_approx(ranger.forced_velocity.length()*ranger.control_move_scale,4.0*response.freeze_move_scale), "roll speed applies movement scale only once")
	statuses.apply(ranger,"test_slow",1.0,{})
	check(is_equal_approx(ranger.control_move_scale,minf(response.freeze_move_scale,builds.status("test_slow").move_scale)), "path and boss movement slow take strongest, not product")
	statuses.clear(); reset(); brain._start("burst")
	statuses.apply(ranger,freeze.id,freeze.duration_sec,{})
	for i in 1500:
		if brain.state == "recovery": break
		brain.tick(.01); statuses.tick(.01)
	check(shots.size() == 3, "slow and restoration neither skip nor repeat burst cues")
	statuses.clear()
	statuses.apply(ranger,"frost_mark",5.0,{})
	statuses.apply(ranger,freeze.id,freeze.duration_sec,{})
	statuses.remove(ranger,freeze.id)
	check(ranger.control_action_scale == 1.0 and statuses.snapshot(ranger).has("frost_mark"), "consumption restores tempo but preserves mark")
	check(not statuses.apply(ranger,freeze.id,freeze.duration_sec,{}), "consumption starts immunity")
	var view := preload("res://presentation/builds/mechanism_view.gd").new()
	root.add_child(view)
	view.configure(load("res://presentation/builds/mechanism_style.tres"))
	view.sync(statuses.visuals(),0.0)
	check(view._statuses.has(ranger.handle), "mark and immunity presentation consumes snapshots")
	view.clear(); view.free()
	statuses.clear(); statuses.apply(ranger,freeze.id,freeze.duration_sec,{})
	ranger.health.apply(ranger.health.maximum,false)
	check(statuses.diagnostics().tracked_actors == 0 and ranger.control_action_scale == 1.0, "death cleans control and tempo")
	statuses.clear(); runtime.clear(); ranger.free(); player.free()
	print("BOSS_FROST_WINDOW ",JSON.stringify({"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
