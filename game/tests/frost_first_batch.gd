extends "res://tests/action_build_runtime.gd"
const Session = preload("res://app/session/training_build_session.gd")
func run() -> void:
	builds = BuildLoader.new().load_catalog(); combat = CombatLoader.new().load_catalog()
	check(builds != null and combat != null, "catalogs load")
	if builds == null or combat == null: quit(1); return
	resolver.configure(builds)
	for preset in builds.test_presets():
		var session := Session.new(); session.configure(builds, 1, func(_s): return OK)
		check(session.apply_test_preset(preset.id).ok, "preset accepted: " + preset.id)
	var f := setup([select("contact_freeze", "skill"), select("returning_wave", "skill")])
	var target = actor("elite_ranger", 1, Vector3(0, 0, -2))
	target.set_damage_immunity(true)
	cast(f, "skill")
	for i in 50: f.runtime.tick(0.03)
	check(f.runtime.statuses.freeze_progress(target).is_empty(), "boss window needs no cumulative buildup")
	check(not target.control_locked and f.runtime.statuses.snapshot(target).has("frost_mark"), "mark is independent of elite hard control")
	clean(f)
	f = setup([select("contact_freeze", "skill"), select("ice_coat", "skill")])
	target = actor("scout", 1, Vector3(0, 0, -1))
	cast(f, "skill"); f.runtime.tick(0.1)
	check(f.player.protection_amount > 0.0, "real freeze grants protection")
	var shield: float = f.player.protection_amount
	f.player.set_damage_immunity(true); f.player.receive_hit(5)
	check(f.player.protection_amount == shield, "training immunity does not consume shield")
	f.player.set_damage_immunity(false)
	check(f.player.receive_hit(shield + 5.0) == 5.0 and f.player.protection_amount == 0.0, "shield absorbs finite damage")
	clean(f)
	f = setup([select("contact_freeze", "skill"), select("shatter_heavy", "special")])
	target = actor("brute", 1, Vector3(0, 0, -1))
	target.health.maximum = 500.0; target.health.current = 500.0
	cast(f, "skill"); f.runtime.tick(0.1)
	check(target.control_locked, "target frozen by earlier Q")
	f.player.runner.cancel(); cast(f, "special")
	check(not target.control_locked, "heavy consumes earlier freeze")
	check(not f.runtime.statuses.control_snapshot(target).is_empty(), "shatter grants thaw immunity")
	clean(f)
	f = setup([select("charged_wave", "skill")])
	f.player.press_skill()
	check(f.player.charging_skill and f.player.runner.cast_id == 0, "hold does not fire normal wave first")
	f.player.step(float(f.player.charge_parameters().max_charge_sec))
	f.player.release_skill(); f.player.step(0.01); f.runtime.tick(0.001)
	check(f.runtime.projectiles().size() == 1 and f.player.runner.cast_charged, "release submits exactly one charged wave")
	check(f.runtime.projectiles()[0].radius > builds.projectile("sword_wave").radius_m, "charged logic radius increases")
	check(f.player.runner.cooldown_for("skill") > combat.ability("wave_cast").cooldown, "charged cooldown increases")
	f.player.release_skill(); f.runtime.tick(0.001)
	check(f.runtime.projectiles().size() == 1, "duplicate release does not fire twice")
	clean(f)
	f = setup([select("contact_freeze", "skill"), select("frost_path", "skill")])
	cast(f,"skill"); f.runtime.tick(0.3)
	check(not f.runtime.frost.paths.is_empty(), "distance samples create bounded trail")
	target = actor("scout", 1, f.runtime.frost.paths[0].position)
	f.runtime.tick(0.01)
	check(target.control_move_scale < 1.0 and not target.control_locked, "trail slows without freezing")
	var count: int = f.runtime.frost.paths.size(); f.runtime.tick(0)
	check(f.runtime.frost.paths.size() == count, "pause holds trail")
	clean(f)
	print("FROST_FIRST_BATCH ",JSON.stringify({"failures":failures}))
	quit(0 if failures.is_empty() else 1)
