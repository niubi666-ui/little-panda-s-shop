{"label": "cat_martial_legacy", "ids": ["primary_reach", "special_reach", "wave"]},
{"label": "cat_legacy", "ids": ["chain", "contact_slow", "contact_freeze"]},
{"label": "cat_legacy", "ids": ["freeze_duration", "frost_blast", "shatter_heavy"]}
])
actions = PackedStringArray("primary", "special", "skill")
starting_motion_enabled = true
starting_intensity = 1.0
max_intensity = 1.5
intensity_step = 0.05
toolbar_margin = Vector2(22, 16)
toolbar_gap = 12
control_height = 34.0
font_size = 16
slider_width = 125.0
status_height = 58.0
status_color = Color(0.9, 0.86, 0.68, 1)
background = SubResource("background")
demo_duration = 14.0
demo_events = Array[Dictionary]([{"at": 2.0, "action": "focus", "index": 0}, {"at": 4.0, "action": "focus", "index": 1}, {"at": 6.0, "action": "focus", "index": 2}, {"at": 8.0, "action": "static"}, {"at": 10.0, "action": "dynamic"}, {"at": 12.0, "action": "focus", "index": 0}, {"at": 13.0, "action": "choose", "index": 0}])
catalog_demo_page_sec = 3.0
