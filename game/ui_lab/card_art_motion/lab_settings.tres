"mixed": "火 / 冰 / 雷", "fire": "三张火", "ice": "三张冰", "thunder": "三张雷",
"help": "PgUp / PgDn 翻页 · 悬停 / 方向键切卡 · 1 / 2 / 3 选择 · F 重开",
"gallery_page": "{page}/{total} · {category}",
"cat_fire": "火焰", "cat_ice": "寒冰", "cat_thunder": "雷电", "cat_earth": "大地",
"cat_reactions": "元素反应", "cat_martial": "武技", "cat_legacy": "训练遗留卡",
"cat_ice_thunder": "寒冰 / 雷电", "cat_thunder_earth": "雷电 / 大地",
"cat_earth_reactions": "大地 / 元素反应", "cat_reactions_martial": "元素反应 / 武技",
"cat_martial_legacy": "武技 / 训练遗留卡",
"selected": "已展示选中退场：{name}（仅样板，不领取奖励）",
"paused": "原画动画已暂停", "static": "静态原画", "active": "原画动画播放中"
},
"en": {
"heading": "Living Card Art · All 51 Illustrations",
"subtitle": "Still artwork, local magic in motion",
"dynamic": "Motion [D]", "pause": "Pause [P]", "intensity": "Intensity",
"language": "中文 [L]", "reopen": "Reopen [F]", "quit": "Close lab",
"mixed": "Fire / Ice / Thunder", "fire": "Three Fire", "ice": "Three Ice", "thunder": "Three Thunder",
"help": "PgUp / PgDn pages · Hover / arrows focus · 1 / 2 / 3 choose · F reopen",
"gallery_page": "{page}/{total} · {category}",
"cat_fire": "Fire", "cat_ice": "Ice", "cat_thunder": "Thunder", "cat_earth": "Earth",
"cat_reactions": "Reactions", "cat_martial": "Martial", "cat_legacy": "Legacy Training",
"cat_ice_thunder": "Ice / Thunder", "cat_thunder_earth": "Thunder / Earth",
"cat_earth_reactions": "Earth / Reactions", "cat_reactions_martial": "Reactions / Martial",
"cat_martial_legacy": "Martial / Legacy",
"selected": "Selection exit shown: {name} (preview only; no reward granted)",
"paused": "Illustration motion paused", "static": "Static artwork", "active": "Illustration motion playing"
}}
groups = Array[Dictionary]([{"label": "mixed", "ids": ["fire_core", "ice_core", "thunder_core"]}, {"label": "fire", "ids": ["fire_core", "fire_core", "fire_core"]}, {"label": "ice", "ids": ["ice_core", "ice_core", "ice_core"]}, {"label": "thunder", "ids": ["thunder_core", "thunder_core", "thunder_core"]}])
catalog_groups = Array[Dictionary]([
{"label": "cat_fire", "ids": ["fire_core", "fire_kindling", "fire_blaze"]},
{"label": "cat_fire", "ids": ["fire_linger", "fire_mastery_burst", "fire_mastery_heat"]},
{"label": "cat_ice", "ids": ["ice_core", "ice_deep", "ice_lasting"]},
{"label": "cat_ice", "ids": ["ice_brittle", "shatter_followup", "opening_strike"]},
{"label": "cat_ice", "ids": ["frost_path", "ice_coat", "ice_mastery_burst"]},
{"label": "cat_ice_thunder", "ids": ["ice_mastery_cold", "thunder_core", "thunder_chain"]},
{"label": "cat_thunder", "ids": ["thunder_surge", "thunder_reach", "thunder_mastery_burst"]},
{"label": "cat_thunder_earth", "ids": ["thunder_mastery_storm", "earth_core", "earth_crush"]},
{"label": "cat_earth", "ids": ["earth_quake", "earth_layers", "earth_mastery_burst"]},
{"label": "cat_earth_reactions", "ids": ["earth_mastery_weight", "dual_steam", "dual_overload"]},
{"label": "cat_reactions", "ids": ["dual_lava", "dual_superconduct", "dual_shatter"]},
{"label": "cat_reactions_martial", "ids": ["dual_magnet", "power", "agility"]},
