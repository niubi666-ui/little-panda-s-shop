[gd_resource type="Resource" load_steps=4 format=3]

[ext_resource type="Script" path="res://ui_lab/card_art_motion/lab_settings.gd" id="script"]

[sub_resource type="Gradient" id="forest"]
offsets = PackedFloat32Array(0, 0.45, 1)
colors = PackedColorArray(0.16, 0.22, 0.14, 1, 0.055, 0.12, 0.085, 1, 0.015, 0.035, 0.028, 1)

[sub_resource type="GradientTexture2D" id="background"]
gradient = SubResource("forest")
width = 512
height = 512
fill = 1
fill_from = Vector2(0.5, 0.35)
fill_to = Vector2(1, 1)

[resource]
script = ExtResource("script")
default_locale = "zh_CN"
locales = PackedStringArray("zh_CN", "en")
translations = {
"zh_CN": {
"heading": "卡牌原画动画 · 全部 51 张",
